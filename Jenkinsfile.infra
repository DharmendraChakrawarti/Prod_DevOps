// =============================================================
//  JENKINSFILE.INFRA — Infrastructure Pipeline for DC Music
// =============================================================
//
//  WHAT THIS PIPELINE DOES (8 stages):
//  ------------------------------------
//  1. Checkout              → Pulls code from GitHub
//  2. Setup Remote State    → Creates S3 bucket + DynamoDB lock table (idempotent)
//  3. Terraform Init        → Initializes Terraform with S3 backend
//  4. Terraform Validate    → Validates syntax and configuration
//  5. Terraform Plan        → Creates an execution plan (saved to file)
//  6. Manual Approval       → Waits for human review before applying (30 min timeout)
//  7. Terraform Apply       → Applies the saved plan
//  8. Update Kubeconfig     → Configures kubectl for the new EKS cluster
//
//  PURPOSE:
//  --------
//  This is a SEPARATE pipeline for infrastructure changes only.
//  Application deployments use the main Jenkinsfile instead.
//  This separation ensures infrastructure changes always go
//  through a manual approval gate.
//
//  PREREQUISITES:
//  -------------------------------------------------
//  1. Jenkins Credentials:
//     - 'aws-credentials'  → AWS Access Key + Secret Key
//     - 'rds-password'     → Secret text (RDS master password)
//
//  2. Jenkins Agent:
//     - Terraform >= 1.5.0 installed
//     - AWS CLI v2 installed
//     - kubectl installed
//
// =============================================================

pipeline {
    agent any

    // ---------------------------------------------------------
    // ENVIRONMENT — Global variables used across stages
    // ---------------------------------------------------------
    environment {
        AWS_REGION       = 'ap-south-1'
        PROJECT_NAME     = 'dcmusic'
        EKS_CLUSTER_NAME = 'dcmusic-eks'
        ENVIRONMENT      = 'dev'
    }

    // ---------------------------------------------------------
    // PIPELINE STAGES
    // ---------------------------------------------------------
    stages {

        // =====================================================
        // STAGE 1: CHECKOUT CODE
        // =====================================================
        stage('Checkout') {
            steps {
                echo '📥 Pulling latest code from GitHub...'
                checkout scm
            }
        }

        // =====================================================
        // STAGE 2: SETUP REMOTE STATE BACKEND
        // =====================================================
        // Runs the idempotent setup-remote-state.sh script to
        // ensure S3 bucket + DynamoDB table exist before init.
        // Single source of truth for remote state creation.
        // =====================================================
        stage('Setup Remote State') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {
                    dir('terraform') {
                        echo '🔧 Running setup-remote-state.sh...'
                        sh 'chmod +x setup-remote-state.sh && ./setup-remote-state.sh'
                    }
                }
            }
        }

        // =====================================================
        // STAGE 3: TERRAFORM INIT
        // =====================================================
        // Initializes Terraform with the S3 backend created above.
        // Uses -backend-config flags for dynamic configuration
        // so no account-specific values are hardcoded in code.
        // =====================================================
        stage('Terraform Init') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {
                    dir('terraform') {
                        echo '🏗️ Initializing Terraform with S3 backend...'
                        sh """
                            ACCOUNT_ID=\$(aws sts get-caller-identity --query Account --output text)
                            terraform init \\
                              -backend-config="bucket=${PROJECT_NAME}-tf-state-\${ACCOUNT_ID}" \\
                              -backend-config="key=${ENVIRONMENT}/terraform.tfstate" \\
                              -backend-config="region=${AWS_REGION}" \\
                              -backend-config="dynamodb_table=${PROJECT_NAME}-tf-lock" \\
                              -backend-config="encrypt=true"
                        """
                        echo '✅ Terraform initialized with S3 remote state!'
                    }
                }
            }
        }

        // =====================================================
        // STAGE 4: TERRAFORM VALIDATE
        // =====================================================
        // Checks syntax and internal consistency of the config.
        // Catches errors early before the plan stage.
        // =====================================================
        stage('Terraform Validate') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {
                    dir('terraform') {
                        echo '🔍 Validating Terraform configuration...'
                        sh 'terraform validate'
                        echo '✅ Configuration is valid!'
                    }
                }
            }
        }

        // =====================================================
        // STAGE 5: TERRAFORM PLAN
        // =====================================================
        // Creates an execution plan and saves it to a file.
        // DB password is passed via TF_VAR_ env var (not -var)
        // to avoid leaking it in process list or Jenkins logs.
        // =====================================================
        stage('Terraform Plan') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'],
                    string(credentialsId: 'rds-password', variable: 'TF_VAR_db_password')
                ]) {
                    dir('terraform') {
                        echo '📋 Planning infrastructure changes...'
                        sh 'terraform plan -out=tfplan'
                        echo '✅ Terraform plan saved to tfplan'
                    }
                }
            }
        }

        // =====================================================
        // STAGE 6: MANUAL APPROVAL (30 min timeout)
        // =====================================================
        // Pauses the pipeline and waits for a human to review
        // the plan output. Times out after 30 minutes to avoid
        // blocking the Jenkins executor indefinitely.
        // =====================================================
        stage('Manual Approval') {
            steps {
                echo '⏸️ Waiting for manual approval...'
                timeout(time: 30, unit: 'MINUTES') {
                    input message: 'Review the Terraform plan above. Proceed with apply?',
                          ok: 'Apply'
                }
            }
        }

        // =====================================================
        // STAGE 7: TERRAFORM APPLY
        // =====================================================
        // Applies the saved plan file. The plan already has all
        // variable values baked in, so no credentials are needed
        // for Terraform variables — only AWS access.
        // =====================================================
        stage('Terraform Apply') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {
                    dir('terraform') {
                        echo '🚀 Applying infrastructure changes...'
                        sh 'terraform apply -auto-approve tfplan'
                        echo '✅ Infrastructure updated successfully!'
                    }
                }
            }
        }

        // =====================================================
        // STAGE 8: UPDATE KUBECONFIG
        // =====================================================
        // After infrastructure is provisioned, configures kubectl
        // on the Jenkins agent and prints the command for local
        // developer use.
        // =====================================================
        stage('Update Kubeconfig') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                  credentialsId: 'aws-credentials',
                                  accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                                  secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']]) {

                    echo '🔧 Configuring kubectl for EKS cluster...'
                    sh "aws eks update-kubeconfig --name ${EKS_CLUSTER_NAME} --region ${AWS_REGION}"

                    echo """
                    ✅ ================================================
                    ✅  INFRASTRUCTURE READY!
                    ✅ ================================================
                    ✅  To configure kubectl on your local machine:
                    ✅  aws eks update-kubeconfig --name ${EKS_CLUSTER_NAME} --region ${AWS_REGION}
                    ✅
                    ✅  Then verify with:
                    ✅  kubectl get nodes
                    ✅ ================================================
                    """
                }
            }
        }
    }

    // ---------------------------------------------------------
    // POST ACTIONS
    // ---------------------------------------------------------
    post {
        always {
            // Clean up the plan file (contains sensitive data)
            dir('terraform') {
                sh 'rm -f tfplan'
            }
        }
        success {
            echo '✅ Infrastructure pipeline completed successfully!'
        }
        failure {
            echo '❌ Infrastructure pipeline failed! Check the logs above.'
        }
    }
}
